+
+// S2.5b (patch Velordo): niente dlopen (loader solo-statico) — backend e
+// proc-macro dinamici non caricabili (il backend e' linkato statico; le
+// victory crate non usano proc-macro). Errori onesti se mai raggiunti.
+#[cfg(target_os = "velordo")]
+fn no_dylib(path: &Path) -> DylibError {
+    DylibError::DlOpen(path.display().to_string(), "dynamic loading unsupported on Velordo".to_string())
+}
+
+#[cfg(target_os = "velordo")]
+pub unsafe fn load_symbol_from_dylib<T: Copy>(
+    path: &Path,
+    _sym_name: &str,
+) -> Result<T, DylibError> {
+    Err(no_dylib(path))
+}
+
+#[cfg(target_os = "velordo")]
+pub(crate) fn dlsym_proc_macros(
+    path: &Path,
+    _stable_crate_id: StableCrateId,
+) -> Result<&'static [ProcMacroClient], DylibError> {
+    Err(no_dylib(path))
+}
